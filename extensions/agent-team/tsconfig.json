{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "../../vendor/pi-mono",
    "paths": {
      "@earendil-works/pi-coding-agent": ["packages/coding-agent/src/index.ts"],
      "typebox": ["node_modules/typebox"]
